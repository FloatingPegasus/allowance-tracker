# Server-only credentials. Copy to .env.local; never use a VITE_ prefix.
BROWSERBASE_API_KEY=
# Optional when the API key is scoped to one project.
BROWSERBASE_PROJECT_ID=
# Use a persistent private volume when hosting the backend.
ALLOWANCE_DATA_DIR=.allowance

# Hosted server only. Use HTTPS outside localhost.
ALLOWANCE_ORIGIN=
# Base64-encoded 32-byte random key; keep a separate secure backup.
ALLOWANCE_ENCRYPTION_KEY=
# Run node scripts/create-owner.mjs for a private generated password and hash.
ALLOWANCE_PASSWORD_HASH=

{
  "name": "allowance_tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:ui": "node --import tsx scripts/check-private-ui.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local --import tsx server/main.ts",
    "setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-owner.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/claude-code": "2.1.274",
    "@openai/codex": "0.157.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

{
  "name": "allowance_tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "build:hosted": "tsc -b && vite build --mode hosted && vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env.local dist-server/hosted.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
